// The skins, generated, in a fixed order (appearance/skinIndex indexes
// this list). Do not edit by hand.

export struct Skin {
    name: string,
    hint: string,
    dark: bool,
    radius: int,
    compact: bool,
    bg: color,
    sidebar: color,
    surface: color,
    surface-hi: color,
    hover: color,
    border: color,
    text: color,
    text-dim: color,
    text-faint: color,
    accent: color,
    on-accent: color,
    good: color,
    warn: color,
}

