[Desktop Entry]
Type=Application
Name=Sonkore
GenericName=Music Player
Comment=Hi-Fi music player with bit-perfect output, equalizer and AutoEQ
Exec=sonkore %U
TryExec=sonkore
Icon=com.axiokyn.Sonkore
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/mp3;audio/wav;audio/x-wav;audio/mp4;audio/x-m4a;audio/aac;audio/ogg;audio/x-vorbis+ogg;audio/x-flac+ogg;audio/aiff;audio/x-aiff;audio/x-matroska;audio/x-dsf;audio/x-dff;application/x-cue;
Keywords=music;audio;player;flac;hifi;bit-perfect;equalizer;autoeq;
StartupWMClass=sonkore
SingleMainWindow=true
Actions=PlayPause;Next;Previous;

[Desktop Action PlayPause]
Name=Play / Pause
Exec=sonkore --play-pause

[Desktop Action Next]
Name=Next track
Exec=sonkore --next

[Desktop Action Previous]
Name=Previous track
Exec=sonkore --previous
