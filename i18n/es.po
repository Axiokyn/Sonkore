msgctxt "VolumeModeMenu"
msgid "Volume control"
msgstr "Control de volumen"

msgctxt "VolumeModeMenu"
msgid "Automatic"
msgstr "Automático"

msgctxt "VolumeModeMenu"
msgid "The system volume with a PipeWire output (the DAC's own control where it has one); fixed at 100 % on a direct output; Sonkore's own volume otherwise."
msgstr "El volumen del sistema con una salida PipeWire (el control del propio DAC cuando lo tiene); fijo al 100 % en una salida directa; el volumen de Sonkore en los demás casos."

msgctxt "VolumeModeMenu"
msgid "Fixed at 100 % on a direct output (set it on the DAC or the amplifier); Sonkore's own volume otherwise."
msgstr "Fijo al 100 % en una salida directa (se ajusta en el DAC o el amplificador); si no, el volumen propio de Sonkore."

msgctxt "VolumeModeMenu"
msgid "Digital"
msgstr "Digital"

msgctxt "VolumeModeMenu"
msgid "Sonkore scales the samples: below 100 % the path is no longer bit-perfect."
msgstr "Sonkore escala las muestras: por debajo del 100 % la ruta deja de ser bit-perfect."

msgctxt "VolumeModeMenu"
msgid "DAC"
msgstr "DAC"

msgctxt "VolumeModeMenu"
msgid "Moves the DAC's own volume control, through PipeWire or directly: the audio stays bit-perfect."
msgstr "Mueve el control de volumen del propio DAC, por PipeWire o directamente: el audio sigue bit-perfect."

msgctxt "VolumeModeMenu"
msgid "Moves the DAC's own volume control: the audio stays bit-perfect."
msgstr "Mueve el control de volumen del propio DAC: el audio sigue siendo bit-perfect."

msgctxt "VolumeModeMenu"
msgid "Audio settings…"
msgstr "Ajustes de audio…"

