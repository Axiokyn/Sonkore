msgstr "Lautstärkeregelung"

msgctxt "VolumeModeMenu"
msgid "Automatic"
msgstr "Automatisch"

msgctxt "VolumeModeMenu"
msgid "The system volume with a PipeWire output (the DAC's own control where it has one); fixed at 100 % on a direct output; Sonkore's own volume otherwise."
msgstr "Die Systemlautstärke bei einer PipeWire-Ausgabe (der eigene Regler des DAC, wenn er einen hat); fest bei 100 % bei einer direkten Ausgabe; sonst Sonkores eigene Lautstärke."

msgctxt "VolumeModeMenu"
msgid "Fixed at 100 % on a direct output (set it on the DAC or the amplifier); Sonkore's own volume otherwise."
msgstr "Auf 100 % fixiert bei direkter Ausgabe (am DAC oder Verstärker einstellen); sonst Sonkores eigene Lautstärke."

msgctxt "VolumeModeMenu"
msgid "Digital"
msgstr "Digital"

msgctxt "VolumeModeMenu"
msgid "Sonkore scales the samples: below 100 % the path is no longer bit-perfect."
msgstr "Sonkore skaliert die Samples: unter 100 % ist der Signalweg nicht mehr bit-perfect."

msgctxt "VolumeModeMenu"
