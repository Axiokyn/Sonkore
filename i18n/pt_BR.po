msgctxt "TracksPage"
msgid "Click the heart on any track to keep it here."
msgstr "Clique no coração de qualquer faixa para guardá-la aqui."

msgctxt "TracksPage"
msgid "Add a music folder — it's watched and kept in sync automatically.\nFLAC, WAV, MP3, ALAC, AAC, Vorbis, DSD and CUE sheets."
msgstr "Adicione uma pasta de música: ela é monitorada e sincronizada automaticamente.\nFLAC, WAV, MP3, ALAC, AAC, Vorbis, DSD e folhas CUE."

msgctxt "TracksPage"
