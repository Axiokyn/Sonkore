msgid "No tracks match “{0}”"
msgstr "Nenhuma faixa corresponde a “{0}”"

msgctxt "VolumeModeMenu"
msgid "Volume control"
msgstr "Controle de volume"

msgctxt "VolumeModeMenu"
msgid "Automatic"
msgstr "Automático"

msgctxt "VolumeModeMenu"
msgid "The system volume with a PipeWire output (the DAC's own control where it has one); fixed at 100 % on a direct output; Sonkore's own volume otherwise."
msgstr "O volume do sistema com uma saída PipeWire (o controle do próprio DAC quando ele tem um); fixo em 100 % numa saída direta; o volume do Sonkore nos demais casos."

msgctxt "VolumeModeMenu"
msgid "Fixed at 100 % on a direct output (set it on the DAC or the amplifier); Sonkore's own volume otherwise."
msgstr "Fixo em 100 % numa saída direta (ajuste no DAC ou no amplificador); caso contrário, o volume próprio do Sonkore."

msgctxt "VolumeModeMenu"
msgid "Digital"
msgstr "Digital"

msgctxt "VolumeModeMenu"
msgid "Sonkore scales the samples: below 100 % the path is no longer bit-perfect."
msgstr "O Sonkore escala as amostras: abaixo de 100 % o caminho deixa de ser bit-perfect."

msgctxt "VolumeModeMenu"
msgid "DAC"
msgstr "DAC"

msgctxt "VolumeModeMenu"
msgid "Moves the DAC's own volume control, through PipeWire or directly: the audio stays bit-perfect."
msgstr "Move o controle de volume do próprio DAC, via PipeWire ou diretamente: o áudio continua bit-perfect."

msgctxt "VolumeModeMenu"
msgid "Moves the DAC's own volume control: the audio stays bit-perfect."
msgstr "Move o controle de volume do próprio DAC: o áudio continua bit-perfect."

msgctxt "VolumeModeMenu"
msgid "Audio settings…"
msgstr "Ajustes de áudio…"

msgctxt "WinEndpointVolume"
msgid "Output volume"
msgstr "Volume de saída"

