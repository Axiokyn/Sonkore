msgstr "Attuale: {0}."

msgctxt "SettingsPage"
msgid "Smoother animations. Recommended."
msgstr "Animazioni più fluide. Consigliato."

msgctxt "SettingsPage"
msgid "Library, playlists and EQ profiles are kept."
msgstr "Libreria, playlist e profili EQ vengono mantenuti."

msgctxt "SettingsPage"
