msgctxt "VolumeModeMenu"
msgid "Volume control"
msgstr "Controllo del volume"

msgctxt "VolumeModeMenu"
msgid "Automatic"
msgstr "Automatico"

msgctxt "VolumeModeMenu"
msgid "The system volume with a PipeWire output (the DAC's own control where it has one); fixed at 100 % on a direct output; Sonkore's own volume otherwise."
msgstr "Il volume di sistema con un'uscita PipeWire (il controllo del DAC stesso quando ce l'ha); fisso al 100 % su un'uscita diretta; il volume di Sonkore negli altri casi."

msgctxt "VolumeModeMenu"
msgid "Fixed at 100 % on a direct output (set it on the DAC or the amplifier); Sonkore's own volume otherwise."
msgstr "Fisso al 100 % su un'uscita diretta (si regola sul DAC o sull'amplificatore); altrimenti il volume di Sonkore."

msgctxt "VolumeModeMenu"
msgid "Digital"
msgstr "Digitale"

msgctxt "VolumeModeMenu"
msgid "Sonkore scales the samples: below 100 % the path is no longer bit-perfect."
msgstr "Sonkore scala i campioni: sotto il 100 % il percorso non è più bit-perfect."

msgctxt "VolumeModeMenu"
msgid "DAC"
msgstr "DAC"

msgctxt "VolumeModeMenu"
msgid "Moves the DAC's own volume control, through PipeWire or directly: the audio stays bit-perfect."
msgstr "Muove il controllo del volume del DAC stesso, tramite PipeWire o direttamente: l'audio resta bit-perfect."

msgctxt "VolumeModeMenu"
msgid "Moves the DAC's own volume control: the audio stays bit-perfect."
msgstr "Agisce sul controllo di volume del DAC: l'audio resta bit-perfect."

msgctxt "VolumeModeMenu"
msgid "Audio settings…"
msgstr "Impostazioni audio…"

